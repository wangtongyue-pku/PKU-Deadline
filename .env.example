# Documentation only: the app does NOT automatically load .env files.
# Never put actual keys in this example. Use process environment variables.
# Live transport stays disabled by default; enable only after explicit consent.
PKU_REAL_API_ENABLED=0
PKU_DEEPSEEK_BASE_URL=https://api.deepseek.com
PKU_DEEPSEEK_MODEL=deepseek-flash
PKU_DEEPSEEK_API_KEY=
PKU_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
PKU_MIMO_MODEL=mimo-v2.6-flash
PKU_MIMO_API_KEY=
# CNY per million tokens. Optional overrides; verify the selected model's rates.
# Leave unset to use documented conservative built-in rates, NOT empty variables.
# PKU_DEEPSEEK_INPUT_PRICE=2
# PKU_DEEPSEEK_OUTPUT_PRICE=8
# PKU_MIMO_INPUT_PRICE=1
# PKU_MIMO_OUTPUT_PRICE=2
PKU_AI_DAILY_LIMIT_CNY=1
PKU_AI_MAX_OUTPUT_TOKENS=2048
PKU_AI_TIMEOUT_SECONDS=30
# Optional local SQLite path. Default: <project>/data/deadlines.sqlite3
PKU_DATABASE_PATH=
